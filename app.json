{
  "expo": {
    "name": "Oxide",
    "slug": "oxide",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0F0E0E",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "dev.oxide.app"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "output": "single",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-sharing",
      "./plugins/withOxideToolchain"
    ],
    "scheme": "oxide",
    "backgroundColor": "#0F0E0E",
    "extra": {
      "toolchainPayloadUrl": "https://REPLACE-ME.example.invalid/oxide/toolchain/1.99.1/manifest.json",
      "toolchainPayloadUrlNote": "PLACEHOLDER: host the output of toolchain/make-data-payload.sh and put its manifest.json URL here. See toolchain/README.md."
    }
  }
}
